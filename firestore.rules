rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Open by design (per your choice) — anyone with the site link can
    // read/write fixtures and settings. No login, no per-user tracking.
    // Basic shape checks below just stop garbage/huge documents from
    // being written, not who writes them.

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
                      ['class','weekday','slot','originalTeacher','subTeacher','startDate','endDate','days']
                    )
                    && request.resource.data.class is string
                    && request.resource.data.weekday is string
                    && request.resource.data.slot is int
                    && request.resource.data.days is int
                    && request.resource.data.days > 0 && request.resource.data.days <= 60;
      allow delete: if true;
      allow update: if false; // fixtures are create-once / delete-to-cancel, never edited in place
    }

    match /config/settings {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['resetDay','resetTime']);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
